{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and municipal identity",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["citizen", "admin", "field_lead", "traffic_lead"] },
        "karma": { "type": "number" },
        "level": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "displayName", "email", "role"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User accessibility and dashboard preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "viewMode": { "type": "string", "enum": ["citizen", "ops"] },
        "accessibilityMode": { "type": "boolean" },
        "elevatorVital": { "type": "boolean" },
        "lowFloorBus": { "type": "boolean" },
        "max3PctIncline": { "type": "boolean" },
        "sensoryCues": { "type": "boolean" },
        "preferredRouting": { "type": "string", "enum": ["least-walking", "fastest", "lowest-cost", "max-accessible"] },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "viewMode"]
    },
    "SavedRoute": {
      "title": "SavedRoute",
      "description": "User saved routes for easy wayfinding",
      "type": "object",
      "properties": {
        "routeId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "origin": { "type": "string", "maxLength": 200 },
        "destination": { "type": "string", "maxLength": 200 },
        "time": { "type": "string", "maxLength": 32 },
        "cost": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["routeId", "userId", "name"]
    },
    "CivicTicket": {
      "title": "CivicTicket",
      "description": "Public hazard or infrastructure incident ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 256 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "priority": { "type": "string", "enum": ["P1 CRITICAL", "P2 HIGH", "P2 MED", "P3 NOMINAL"] },
        "status": { "type": "string", "enum": ["SUBMITTED", "ASSIGNED", "IN REPAIR", "RESOLVED"] },
        "confidence": { "type": "number" },
        "depthCm": { "type": "number" },
        "assignedCrew": { "type": "string", "maxLength": 128 },
        "assignedVehicle": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "upvotes": { "type": "number" },
        "proofHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "title", "category", "location", "priority", "status"]
    },
    "CitizenQualityReview": {
      "title": "CitizenQualityReview",
      "description": "Citizen post-repair quality audit and feedback",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string", "maxLength": 128 },
        "ticketId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "tags": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["reviewId", "ticketId", "userId", "rating"]
    }
  },
  "firestore": {
    "/users/{userId}/profile/info": {
      "schema": "UserProfile",
      "description": "Private user identity and municipal badge profile"
    },
    "/users/{userId}/preferences/settings": {
      "schema": "UserPreferences",
      "description": "Cross-device user preferences and accessibility settings"
    },
    "/users/{userId}/savedRoutes/{routeId}": {
      "schema": "SavedRoute",
      "description": "User saved routes for transit wayfinding"
    },
    "/tickets/{ticketId}": {
      "schema": "CivicTicket",
      "description": "Civic issue tickets generated by citizens or IoT sensors"
    },
    "/tickets/{ticketId}/reviews/{reviewId}": {
      "schema": "CitizenQualityReview",
      "description": "Citizen reviews on completed infrastructure repairs"
    }
  }
}
